              "resource_kind": 1,
              "resource_name": 2,
              "container_name": 3,
              "image_registry": 4,
              "image_repository": 5,
              "image_tag": 6,
              "Value #A": 7,
              "Value #B": 8,
              "Value #C": 9,
              "Value #D": 10,
              "Value #E": 11
            }
          }
