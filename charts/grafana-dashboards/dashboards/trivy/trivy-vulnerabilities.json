          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Critical",
              "Value #B": "High",
              "Value #C": "Medium",
              "Value #D": "Low",
              "Value #E": "Unknown",
              "namespace": "Namespace",
              "resource_kind": "Kind",
              "resource_name": "Workload",
              "container_name": "Container",
              "image_registry": "Registry",
              "image_repository": "Repository",
              "image_tag": "Tag"
