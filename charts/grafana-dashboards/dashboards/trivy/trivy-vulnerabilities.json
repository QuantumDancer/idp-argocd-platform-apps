        },
        "current": {},
        "hide": 0,
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true
      },
      {
        "name": "severity",
        "type": "custom",
        "label": "Severity (CVE table)",
        "query": "Critical,High,Medium,Low,Unknown",
        "current": {
          "text": [
            "Critical",
            "High"
          ],
          "value": [
            "Critical",
            "High"
          ]
        },
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "options": []
      },
      {
        "name": "fixable",
        "type": "custom",
        "label": "Fix available (CVE table)",
        "query": "All : .*,Fixable only : .+",
        "current": {
          "text": "All",
          "value": ".*"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": []
      },
      {
        "name": "workload",
        "type": "textbox",
        "label": "Workload regex (CVE table)",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 0
      }
    ]
  },
