    {
      "type": "table",
      "title": "CVEs (filtered by severity, fixable, workload)",
      "description": "One row per CVE per container. Click an ID to open it on osv.dev, which resolves both CVE and GHSA IDs.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "trivy_vulnerability_id{namespace=~\"$namespace\", severity=~\"$severity\", fixed_version=~\"$fixable\", resource_name=~\"$workload\"}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "severity",
                "vuln_id",
                "vuln_score",
                "resource",
                "installed_version",
                "fixed_version",
                "namespace",
                "resource_name",
