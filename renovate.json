{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": [
    "development"
  ],
  "assignees": [
    "benjamin"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["charts/grafana/templates/grafana\\.yaml"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\n]+)\\n\\s+version: (?<currentValue>[^\\n]+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Automerge Helm chart patch and minor updates after 3 days and passing CI",
      "matchManagers": [
        "helmv3"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "ignoreTests": false,
      "minimumReleaseAge": "3 days"
    }
  ]
}
